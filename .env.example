MRCP_PROJECT_ROOT=/opt/mrcp-dashboard
MRCP_DOCS_DIR=/opt/mrcp-dashboard/docs
MRCP_DATA_FILE=/opt/mrcp-dashboard/docs/data_v2.json

MRCP_ADMIN_API_PORT=5055
MRCP_ADMIN_API_HOST=0.0.0.0
MRCP_ADMIN_TOKEN=change-moi

# Optionnel : declenche immediatement le deploiement GitHub Pages apres une
# correction admin (sinon il attend le prochain creneau planifie, jusqu'a
# 15 min). Token avec scope "repo" (classique) ou "actions:write" (fin-grained).
MRCP_GITHUB_REPO=mrcp-dashboard/mrcp-dashboard
MRCP_GITHUB_TOKEN=

MRCP_LIVE_HOST=0.0.0.0
MRCP_LIVE_PORT=5056
MRCP_LIVE_CORS_ORIGINS=*
